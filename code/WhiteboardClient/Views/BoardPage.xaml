<Page
    x:Class="WhiteboardClient.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:ctl="using:WhiteboardClient.Controls"
    xmlns:models="using:WhiteboardClient.Models"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Tiêu đề từng nhóm trong bảng công cụ -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,8" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Nút công cụ: bật/tắt, kéo giãn hết chiều ngang, nội dung canh trái -->
        <Style x:Key="ToolToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh trên: mã phòng, người dùng, rời phòng -->
        <Grid
            Grid.Row="0"
            Padding="16,8"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock
                    Text="Mã phòng"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="RoomCodeText"
                    VerticalAlignment="Center"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Button x:Name="CopyButton" Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock x:Name="CopyText" Text="Sao chép mã" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button x:Name="FocusButton" Click="FocusButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                        <TextBlock x:Name="FocusText" Text="Mở rộng bảng" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="GreetingText" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button x:Name="LeaveButton" Click="LeaveButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Rời phòng" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Thông báo (lưu ảnh xong, mất kết nối...) -->
        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            IsOpen="False" />

        <!-- Thân: công cụ | bảng vẽ | người online -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Bảng công cụ bên trái -->
            <Border
                x:Name="LeftPanel"
                Width="216"
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,0,16,16">

                        <TextBlock Text="Công cụ vẽ" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,8" />
                        <StackPanel Spacing="4">
                            <ToggleButton x:Name="PenTool" Tag="Pen" Click="ToolButton_Click" Style="{StaticResource ToolToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" Width="20" />
                                    <TextBlock Text="Bút vẽ" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="EraserTool" Tag="Eraser" Click="ToolButton_Click" Style="{StaticResource ToolToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE75C;" FontSize="16" Width="20" />
                                    <TextBlock Text="Tẩy" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="LineTool" Tag="Line" Click="ToolButton_Click" Style="{StaticResource ToolToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x2571;" FontSize="16" Width="20" />
                                    <TextBlock Text="Đường thẳng" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="RectangleTool" Tag="Rectangle" Click="ToolButton_Click" Style="{StaticResource ToolToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x25AD;" FontSize="16" Width="20" />
                                    <TextBlock Text="Hình chữ nhật" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="CircleTool" Tag="Circle" Click="ToolButton_Click" Style="{StaticResource ToolToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x25EF;" FontSize="16" Width="20" />
                                    <TextBlock Text="Hình tròn" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="PanTool" Tag="Pan" Click="ToolButton_Click" Style="{StaticResource ToolToggleStyle}"
                                          ToolTipService.ToolTip="Kéo để di chuyển bảng (hoặc dùng chuột phải / chuột giữa)">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x2725;" FontSize="16" Width="20" />
                                    <TextBlock Text="Di chuyển bảng" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <TextBlock Text="Màu sắc" Style="{StaticResource SectionLabelStyle}" />
                        <GridView
                            x:Name="PaletteView"
                            SelectionMode="Single"
                            Margin="-4,0,0,0"
                            SelectionChanged="PaletteView_SelectionChanged">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:ColorSwatch">
                                    <Border
                                        Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        BorderThickness="1"
                                        Background="{x:Bind Brush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Border
                            x:Name="ColorPreview"
                            Height="32"
                            Margin="0,8,0,8"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <TextBlock
                                x:Name="ColorPreviewText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <Button Content="Chọn màu khác..." Style="{StaticResource PanelButtonStyle}">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker
                                        x:Name="CustomColorPicker"
                                        IsAlphaEnabled="False"
                                        IsMoreButtonVisible="False"
                                        ColorChanged="CustomColorPicker_ColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <TextBlock Text="Cỡ nét" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock x:Name="SizeText" Text="4 px" />
                        <Slider
                            x:Name="SizeSlider"
                            Minimum="1"
                            Maximum="30"
                            Value="4"
                            ValueChanged="SizeSlider_ValueChanged" />

                        <TextBlock Text="Thao tác" Style="{StaticResource SectionLabelStyle}" />
                        <StackPanel Spacing="4">
                            <Button x:Name="ClearButton" Click="ClearButton_Click" Style="{StaticResource PanelButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon
                                        Glyph="&#xE74D;"
                                        FontSize="16"
                                        Width="20"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="Xóa toàn bộ bảng" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource PanelButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE74E;" FontSize="16" Width="20" />
                                    <TextBlock Text="Lưu ảnh (PNG)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Bảng vẽ ở giữa -->
            <Grid Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <ctl:BoardHost
                    x:Name="Surface"
                    PointerPressed="Surface_PointerPressed"
                    PointerMoved="Surface_PointerMoved"
                    PointerReleased="Surface_PointerReleased"
                    PointerCanceled="Surface_PointerCanceled"
                    PointerCaptureLost="Surface_PointerCaptureLost"
                    PointerWheelChanged="Surface_PointerWheelChanged">
                    <canvas:CanvasControl
                        x:Name="BoardCanvas"
                        IsHitTestVisible="False"
                        CreateResources="BoardCanvas_CreateResources"
                        Draw="BoardCanvas_Draw" />
                </ctl:BoardHost>
            </Grid>

            <!-- Danh sách người online bên phải -->
            <Border
                x:Name="RightPanel"
                Width="204"
                Grid.Column="2"
                BorderThickness="1,0,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="OnlineHeader"
                        Margin="16,16,16,8"
                        Text="Đang online (0)"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind Users}"
                        SelectionMode="None"
                        Padding="8,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:UserItem">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture DisplayName="{x:Bind Name}" Width="36" Height="36" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock
                                                Text="Online"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Thanh trạng thái -->
        <Grid
            Grid.Row="3"
            Padding="16,6"
            ColumnSpacing="16"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnDotOk" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <Ellipse x:Name="ConnDotLost" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="ConnText" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <TextBlock
                x:Name="ToolInfoText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock
                x:Name="CoordText"
                Grid.Column="2"
                Text="X: 0, Y: 0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="ZoomOutButton"
                    Content="&#x2212;"
                    Padding="10,2"
                    Click="ZoomOutButton_Click"
                    ToolTipService.ToolTip="Thu nhỏ (hoặc cuộn chuột xuống)" />
                <Button
                    x:Name="ZoomResetButton"
                    MinWidth="68"
                    Padding="8,2"
                    Click="ZoomResetButton_Click"
                    ToolTipService.ToolTip="Vừa khít cửa sổ">
                    <TextBlock x:Name="ZoomText" Text="100%" />
                </Button>
                <Button
                    x:Name="ZoomInButton"
                    Content="+"
                    Padding="10,2"
                    Click="ZoomInButton_Click"
                    ToolTipService.ToolTip="Phóng to (hoặc cuộn chuột lên)" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
